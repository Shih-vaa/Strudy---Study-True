{
  "name": "strudy",
  "productName": "Strudy",
  "version": "0.1.0",
  "description": "Strudy (True Study): a focused lecture player that tracks real study time.",
  "private": true,
  "author": "Apoorv",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
